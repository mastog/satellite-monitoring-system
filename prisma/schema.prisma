generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           String   @default("user")
  points         Int      @default(0)
  totalEarned    Int      @default(0) @map("total_earned")
  equippedMedals String   @default("[]") @map("equipped_medals")
  createdAt      DateTime @default(now()) @map("created_at")

  posts              Post[]
  comments           Comment[]
  votes              Vote[]
  trackedSatellites  TrackedSatellite[]
  notifications      Notification[]
  purchases          Purchase[]
  quizAttempts       QuizAttempt[]
  gameScores         GameScore[]
  createdGameRooms   GameRoom[]        @relation("GameRoomCreator")
  gameRoomSeats      GameRoomSeat[]
  gameRoomActions    GameRoomAction[]
  gameRoomMessages   GameRoomMessage[]

  @@map("users")
}

model Post {
  id         String   @id @default(uuid())
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  title      String
  body       String
  tags       String   @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@map("posts")
}

model Comment {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model Vote {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetId   String   @map("target_id")
  targetType String   @map("target_type")
  vote       String
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetId])
  @@map("votes")
}

model TrackedSatellite {
  userId      String @map("user_id")
  satelliteId String @map("satellite_id")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, satelliteId])
  @@map("tracked_satellites")
}

model TleCache {
  noradId   Int      @id @map("norad_id")
  name      String
  line1     String
  line2     String
  satGroup  String   @map("sat_group")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([satGroup])
  @@map("tle_cache")
}

model SdgCache {
  id            String   @id @default(uuid())
  region        String
  indicatorCode String   @map("indicator_code")
  year          Int
  value         Float?
  fetchedAt     DateTime @default(now()) @map("fetched_at")

  @@unique([region, indicatorCode, year])
  @@map("sdg_cache")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  metadata  String   @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  itemType    String   @map("item_type")
  itemId      String   @map("item_id")
  cost        Int
  purchasedAt DateTime @default(now()) @map("purchased_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("purchases")
}

model ArticleCache {
  id        String   @id @default(uuid())
  sourceId  String   @unique @map("source_id")
  title     String
  abstract  String
  tags      String   @default("[]")
  source    String
  date      String
  readTime  String
  category  String
  url       String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([category])
  @@index([fetchedAt])
  @@map("article_cache")
}

model PaperCache {
  id        String   @id @default(uuid())
  sourceId  String   @unique @map("source_id")
  title     String
  authors   String
  journal   String
  year      Int
  abstract  String
  doi       String
  apiSource String   @map("api_source")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([apiSource])
  @@index([fetchedAt])
  @@map("paper_cache")
}

model ClimateEventCache {
  id                 String   @id @default(uuid())
  eventId            String   @unique @map("event_id")
  type               String
  title              String
  region             String
  lat                Float
  lng                Float
  severity           Int
  detectingSatellite String   @map("detecting_satellite")
  detectionDate      String   @map("detection_date")
  sdgImpact          String   @default("[]") @map("sdg_impact")
  description        String
  areaAffectedKm2    Int      @map("area_affected_km2")
  status             String
  source             String?
  magnitude          Float?
  fetchedAt          DateTime @default(now()) @map("fetched_at")

  @@index([type])
  @@index([fetchedAt])
  @@map("climate_event_cache")
}

model SatelliteSnapshot {
  satelliteId String   @id @map("satellite_id")
  name        String
  noradId     Int      @map("norad_id")
  lat         Float
  lng         Float
  alt         Float
  velocity    Float
  type        String
  tle1        String?
  tle2        String?
  satGroup    String?  @map("sat_group")
  epochAge    Float?   @map("epoch_age")
  snapshotAt  DateTime @map("snapshot_at")
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  @@index([fetchedAt])
  @@index([satGroup])
  @@map("satellite_snapshot")
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  sdgNumber     Int      @map("sdg_number")
  score         Int
  total         Int
  pointsAwarded Int      @default(0) @map("points_awarded")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

model GameScore {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  score     Int
  duration  Float
  level     Int
  kills     Int
  debris    Int
  weapons   String   @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, score(sort: Desc)])
  @@index([userId, createdAt])
  @@map("game_scores")
}

model GameRoom {
  id             String    @id @default(uuid())
  code           String    @unique
  status         String    @default("waiting")
  title          String
  createdById    String    @map("created_by_id")
  currentRound   Int       @default(1) @map("current_round")
  maxRounds      Int       @default(8) @map("max_rounds")
  scenarioSeed   Int       @default(0) @map("scenario_seed")
  treasury       Int       @default(72)
  publicTrust    Int       @default(68) @map("public_trust")
  airQuality     Int       @default(64) @map("air_quality")
  waterSecurity  Int       @default(61) @map("water_security")
  biodiversity   Int       @default(58)
  heatRisk       Int       @default(47) @map("heat_risk")
  deadlineAt     DateTime? @map("deadline_at")
  lastResolvedAt DateTime? @map("last_resolved_at")
  winner         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdBy User              @relation("GameRoomCreator", fields: [createdById], references: [id], onDelete: Cascade)
  seats     GameRoomSeat[]
  rounds    GameRoomRound[]
  actions   GameRoomAction[]
  messages  GameRoomMessage[]

  @@index([status, updatedAt])
  @@index([createdById])
  @@map("game_rooms")
}

model GameRoomSeat {
  id         String   @id @default(uuid())
  roomId     String   @map("room_id")
  userId     String   @map("user_id")
  role       String
  ready      Boolean  @default(false)
  joinedAt   DateTime @default(now()) @map("joined_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, role])
  @@unique([roomId, userId])
  @@index([userId, joinedAt])
  @@index([roomId, lastSeenAt])
  @@map("game_room_seats")
}

model GameRoomRound {
  id             String   @id @default(uuid())
  roomId         String   @map("room_id")
  roundNumber    Int      @map("round_number")
  scenarioId     String   @map("scenario_id")
  scenarioTitle  String   @map("scenario_title")
  snapshotBefore String   @default("{}") @map("snapshot_before")
  resolutionLog  String   @default("[]") @map("resolution_log")
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, roundNumber])
  @@index([roomId, resolvedAt])
  @@map("game_room_rounds")
}

model GameRoomAction {
  id          String   @id @default(uuid())
  roomId       String   @map("room_id")
  roundNumber  Int      @map("round_number")
  userId       String   @map("user_id")
  role         String
  payload      String
  submittedAt  DateTime @default(now()) @map("submitted_at")

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, roundNumber, role])
  @@index([roomId, roundNumber])
  @@index([userId, submittedAt])
  @@map("game_room_actions")
}

model GameRoomMessage {
  id         String   @id @default(uuid())
  roomId      String   @map("room_id")
  userId      String?  @map("user_id")
  userName    String   @map("user_name")
  kind        String   @default("text")
  body        String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@map("game_room_messages")
}
